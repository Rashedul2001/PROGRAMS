@model IEnumerable<Student_Info.Models.ViewModel.ViewingModel>;

@{
	ViewData["Title"] = "Students List";
}

<h2>Student List</h2>
<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Gender</th>
        <th>Address</th>
        <th>Date Of Birth</th>
        <th>Grade</th>
        <th>Image</th>
        <th>Action</th>
    </tr></thead>
    <tbody>
        @if (Model.Any()){
            foreach(var student in Model){
                <tr>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.Gender</td>
                    <td>@student.Address</td>
                    <td>@student.DOB</td>
                    <td>@student.Grade</td>
                    <td>
                        @if (student.Image != null){
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(student.Image)" alt="Student Image" class="img-thumbnail" style="width: 100px; height: 100px"/>
                        }
                        else{
                            <span>No Image</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-controller="CardAndImage" class="btn btn-primary btn-sm" asp-route-id="@student.Id">Edit</a>
                        <a asp-action="Delete" asp-controller="CardAndImage" class="btn btn-danger btn-sm" asp-route-id="@student.Id">Delete</a>
                    </td>
                </tr>
            }
        }
        else{
            <tr><td colspan="4" class="text-center">No Student Available.</td></tr>

        }
    </tbody>
</table>

