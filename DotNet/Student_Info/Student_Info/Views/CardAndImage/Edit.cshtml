@model Student_Info.Models.Domain.StudentDetailModel;

@{
	ViewData["Title"] = "Edit Student Profile";
}


<div class="d-flex justify-content-center align-items-center">
	<div class="col-6 mt-2 p-2 bg-success text-white">
		<h3>Edit Student Profile</h3>
	</div>
</div>

<div class="row d-flex justify-content-center">
	<div class="col-6 ">
		<div class="card">
			<form asp-action="Edit" asp-controller="CardAndImage" method="post" enctype="multipart/form-data">
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="Name"></label>
					<input asp-for="Name" class="form-control" />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="Gender"></label>
					<select asp-for="Gender" class="form-control">
						<option value="Male">Male</option>
						<option value="Female">Female</option>
						<option value="Other">Other</option>
					</select>
					<span asp-validation-for="Gender" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="Address"></label>
					<textarea asp-for="Address" class="form-control"></textarea>
					<span asp-validation-for="Address" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="DOB"></label>
					<input type="date" asp-for="DOB" class="form-control" />
					<span asp-validation-for="DOB" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="Grade"></label>
					<select asp-for="Grade" class="form-control">
						<option value="A">A</option>
						<option value="B">B</option>
						<option value="C">C</option>
						<option value="D">D</option>
					</select>
					<span asp-validation-for="Grade" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 form-group fw-bold">
					<label asp-for="ImageFile"></label>
					<input asp-for="ImageFile" class="form-control" type="file" />
					<span asp-validation-for="ImageFile" class="text-danger"></span>
				</div>
				<div class="px-4 pt-2 col-10 ">
					<button type="submit" class="btn btn-primary">Update</button>
				</div>
			</form>
		</div>
	</div>
</div>