@model HotelBookingSystem.Models.SubmissionModel.EditProfileRequestModel

@{
    ViewData["Title"] = "Edit Profile";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="EditProfile" method="post" class="form-horizontal">
    <input type="hidden" asp-for="UserId" />  
    <div class="form-group">
        <label for="UserName" class="col-md-2 control-label">User Name</label>
        <div class="col-md-10">
            <input type="text" asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserPhone" class="col-md-2 control-label">User Phone</label>
        <div class="col-md-10">
            <input type="text" asp-for="UserPhone" class="form-control" />
            <span asp-validation-for="UserPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserEmail" class="col-md-2 control-label">User Email</label>
        <div class="col-md-10">
            <input type="email" asp-for="UserEmail" class="form-control" />
            <span asp-validation-for="UserEmail" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserAddress" class="col-md-2 control-label">User Address</label>
        <div class="col-md-10">
            <input type="text" asp-for="UserAddress" class="form-control" />
            <span asp-validation-for="UserAddress" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserDOB" class="col-md-2 control-label">User Date of Birth</label>
        <div class="col-md-10">
            <input type="datetime" asp-for="UserDOB" class="form-control" />
            <span asp-validation-for="UserDOB" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserGender" class="col-md-2 control-label">User Gender</label>
        <div class="col-md-10">
            <input type="text" asp-for="UserGender" class="form-control" />
            <span asp-validation-for="UserGender" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserNID" class="col-md-2 control-label">User NID</label>
        <div class="col-md-10">
            <input type="text" asp-for="UserNID" class="form-control" />
            <span asp-validation-for="UserNID" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="UserPassword" class="col-md-2 control-label">New Password (optional)</label>
        <div class="col-md-10">
            <input type="password" asp-for="UserPassword" class="form-control" placeholder="Leave blank to keep current password" />
            <span asp-validation-for="UserPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
