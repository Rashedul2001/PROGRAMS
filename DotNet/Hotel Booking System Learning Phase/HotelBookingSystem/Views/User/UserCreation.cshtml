@model HotelBookingSystem.Models.SubmissionModel.SaveUserRequestModel
@{

    ViewData["Title"] = "User Form";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="SaveUser" method="post" class="form-horizontal">
    <div class="form-group">
        <label asp-for="UserName" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserPhone" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserPhone" class="form-control" />
            <span asp-validation-for="UserPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserEmail" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserEmail" class="form-control" />
            <span asp-validation-for="UserEmail" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserPassword" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserPassword" type="password" class="form-control" />
            <span asp-validation-for="UserPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserAddress" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserAddress" class="form-control" />
            <span asp-validation-for="UserAddress" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserDOB" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserDOB" type="date" class="form-control" />
            <span asp-validation-for="UserDOB" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserNID" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserNID" class="form-control" />
            <span asp-validation-for="UserNID" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="UserGender" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <select asp-for="UserGender" class="form-control">
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="UserGender" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="UserImage" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="UserImage"type ="file"id="imageUpload"  class="form-control" />
            <span asp-validation-for="UserImage" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Image URL</label>
        <div class="col-md-10">
            <input type ="text" id="imageUrl" class="form-control" />
            <span asp-validation-for="UserImage" class="text-danger"></span>
        </div>
    </div>
    <img src="" id="imageDisplay" class="img-thumbnail" alt="Profile Image" />

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10 ">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

@section Scripts {  
   <script>  
       const uploadElement = document.getElementById("imageUpload");  
       const UrlSection = document.getElementById("imageUrl");
       const imageDispalyElement = document.getElementById("imageDisplay")
       imageDispalyElement.style.display = 'none';
       async function uploadImage(e){  
           console.log(e.target.files[0]);  
           let data = new FormData();  
           data.append("file", e.target.files[0]);  
           await fetch("/api/UsersImage",{  
               method:"post",  
               headers:{  
                   "Accept":"*/*"  
               },  
               body: data  
           }).then(response => response.json())  
           .then(result => {  
               console.log(result);  
               UrlSection.value = result.link;

               imageDispalyElement.src = result.link;
               imageDispalyElement.style.display = 'block';
               imageDispalyElement.style.width = '200px';
               imageDispalyElement.style.height = '200px';


           });
       }  
       uploadElement.addEventListener("change", uploadImage);  
   </script>  
}
