@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject SignInManager<IdentityUser> SignInManager



<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] HotelBookingSystem</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/HotelBookingSystem.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/CustomCSS.css" asp-append-version="true" />
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HotelBookingSystem</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse d-sm-inline-flex justify-content-between collapse">
					@if (SignInManager.IsSignedIn(User))
					{
						<ul class="navbar-nav flex-grow-1">
							@if (User.IsInRole("Admin"))
							{
								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle" href="#" id="adminPanelDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
										Admin Panel
									</a>
									<ul class="dropdown-menu" aria-labelledby="adminPanelDropdown">
										<li><a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Rashedul">Dashboard</a></li>
										<li><a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="UserList">Show User List</a></li>
										<li><a class="dropdown-item" asp-area="" asp-controller="UserManagement" asp-action="List">Show User Role List</a></li>
										<li><a class="dropdown-item" asp-area="" asp-controller="UserManagement" asp-action="AjaxList">Ajax Role List </a></li>
										<li><a class="dropdown-item" asp-area="" asp-controller="UserManagement" asp-action="RegUserRole">Not Implemented</a></li>
									</ul>
								</li>
							}
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									User
								</a>
								<ul class="dropdown-menu" aria-labelledby="userDropdown">
									<li><a class="dropdown-item" asp-area="" asp-controller="User" asp-action="Profile"asp-route-id="">Profile</a></li>
									<li><a class="dropdown-item" asp-area="" asp-controller="User" asp-action="UserCreation">Create Profile</a></li>
									<li><a class="dropdown-item" asp-area="" asp-controller="User" asp-action="UserCreation">Book a Hotel</a></li>
								</ul>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									Booking
								</a>
								<ul class="dropdown-menu" aria-labelledby="BookingDropDown">
									<li><a class="dropdown-item" asp-area="" asp-controller="Booking" asp-action="Index">Index</a></li>
									<li><a class="dropdown-item" asp-area="" asp-controller="Booking" asp-action="Create">Create Booking</a></li>
									<li><a class="dropdown-item" asp-area="" asp-controller="User" asp-action="UserCreation">Book a Hotel</a></li>
								</ul>
							</li>
						</ul>
						

						<p class="mt-3 p-1 text-white">@User?.Identity?.Name</p>
						<a class="nav-link" asp-area="" asp-controller="Account" asp-action="LogOut">LogOut</a>
					}
					else
					{
						<div class="d-flex ms-auto">
							<a asp-controller="Account" asp-action="Register" class="btn btn-primary">Register</a>
							<a asp-controller="Account" asp-action="LogIn" class="btn btn-primary mx-1">LogIn</a>
						</div>
					}
					<span class="navbar-text">
						Helpline : 01774919639
					</span>
				</div>
			</div>
		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2024 - HotelBookingSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="https://kit.fontawesome.com/40e9d9ca0b.js" crossorigin="anonymous"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
