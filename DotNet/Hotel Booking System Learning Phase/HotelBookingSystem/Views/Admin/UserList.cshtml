@model IEnumerable<HotelBookingSystem.Models.ViewModel.UserListViewModel>

@{
	ViewData["Title"] = "User List";
}

<div class="container mt-5">
	<h2 class="text-center">All Users</h2>
	@if (!Model.Any())
	{
		<div class="alert alert-warning text-center">No users found.</div>
	}
	else
	{
		<p class="text-center">Total Users: @Model.Count()</p>
		<table class="table table-striped table-bordered">
			<thead class="thead-dark">
				<tr>
					<th>User ID</th>
					<th>User Name</th>
					<th>Phone</th>
					<th>Email</th>
					<th>Address</th>
					<th>Date of Birth</th>
					<th>NID</th>
					<th>Gender</th>
					<th>Role</th>
					<th>Password</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var user in Model)
				{
					<tr>
						<td>@user.UserId</td>
						<td>@user.UserName</td>
						<td>@user.UserPhone</td>
						<td>@user.UserEmail</td>
						<td>@user.UserAddress</td>
						<td>@user.UserDOB.ToShortDateString()</td>
						<td>@user.UserNID</td>
						<td>@user.UserGender</td>
						<td>@user.UserRole</td>
						<td>@user.UserPassword.ToString()</td>
						<td>
							<a asp-controller="Admin" asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-primary btn-sm">Edit</a>
							<a asp-controller="Admin" asp-action="DeleteProfile" asp-route-id = "@user.UserId" method="post" class="btn btn-danger btn-sm">Delete
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>

<style>
	.container {
		background-color: #f9f9f9;
		padding: 20px;
		border-radius: 10px;
		box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
	}

	.text-center {
		color: #333;
	}

	.table {
		margin-top: 20px;
	}

	.thead-dark {
		background-color: #343a40;
		color: #fff;
	}

	.btn-primary {
		margin-right: 5px;
	}

	.btn-danger {
		margin-left: 5px;
	}
</style>
