@model HotelBookingSystem.Models.SubmissionModel.AdminEditRequestModel

@{
	ViewData["Title"] = "Edit User";
}

<div class="container mt-5">
	<h2 class="text-center">Edit User</h2>
	<form asp-action="Edit" method="post">
		<div class="form-group">
			<label asp-for="UserId"></label>
			<input type="text" asp-for="UserId" readonly class="form-control"/>
		</div>
		<div class="form-group">
			<label asp-for="UserName"></label>
			<input asp-for="UserName" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserPhone"></label>
			<input asp-for="UserPhone" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserEmail"></label>
			<input asp-for="UserEmail" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserAddress"></label>
			<input asp-for="UserAddress" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserDOB"></label>
			<input asp-for="UserDOB" class="form-control" type="date" />
		</div>
		<div class="form-group">
			<label asp-for="UserNID"></label>
			<input asp-for="UserNID" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserGender"></label>
			<select asp-for="UserGender" class="form-control">
				<option>Male</option>
				<option>Female</option>
				<option>Other</option>
			</select>
		</div>
		<div class="form-group">
			<label asp-for="UserRole"></label>
			<input asp-for="UserRole" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserImage"></label>
			<input asp-for="UserImage" class="form-control" />
		</div>
		<div class="form-group">
			<label asp-for="UserPassword"></label>
			<input asp-for="UserPassword" class="form-control" type="text" />
		</div>
		<button type="submit" class="btn btn-primary">Save</button>
		<a asp-action="UserList" class="btn btn-secondary">Cancel</a>
	</form>
</div>

<style>
	.container {
		background-color: #f9f9f9;
		padding: 20px;
		border-radius: 10px;
		box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
	}

	.text-center {
		color: #333;
	}

	.form-group {
		margin-bottom: 15px;
	}

	.btn {
		margin-top: 10px;
	}
</style>