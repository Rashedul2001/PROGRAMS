@model IEnumerable<HotelBookingSystem.Models.Domain.BookingModel>
@{
	ViewData["Title"] = "Bookings";
}
<h1>Bookings</h1>
<p>
	<a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>Booking ID</th>
			<th>User</th>
			<th>Check-In</th>
			<th>Check-Out</th>
			<th>Status</th>
			<th>Total Price</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.BookingId</td>
				<td>
					<a asp-controller="User" asp-action="Profile" asp-route-id="@item.BookingId">@item.User.UserName</a>
					//for now it is showing profile it should show details of user with bookings
				</td>
				<td>@item.CheckInDateTime</td>
				<td>@item.CheckOutDateTime</td>
				<td>@item.BookingStatus</td>
				<td>@item.TotalPrice</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
					<a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
					<a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
				</td>
			</tr>
		}

	</tbody>

</table>



