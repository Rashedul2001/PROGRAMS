@model HotelBookingSystem.Models.Domain.BookingModel;

@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>

<h4>New Reservation</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserId" class="control-label">User</label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CheckInDateTime" class="control-label">Check-In Date</label>
                <input asp-for="CheckInDateTime" class="form-control" type="date" />
                <span asp-validation-for="CheckInDateTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CheckOutDateTime" class="control-label">Check-Out Date</label>
                <input asp-for="CheckOutDateTime" class="form-control" type="date" />
                <span asp-validation-for="CheckOutDateTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TotalPrice" class="control-label">Total Price</label>
                <input asp-for="TotalPrice" class="form-control" />
                <span asp-validation-for="TotalPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TotalPerson" class="control-label">Number of Guests</label>
                <input asp-for="TotalPerson" class="form-control" />
                <span asp-validation-for="TotalPerson" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SpecialRequests" class="control-label">Special Requests</label>
                <textarea asp-for="SpecialRequests" class="form-control" rows="3"></textarea>
                <span asp-validation-for="SpecialRequests" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

