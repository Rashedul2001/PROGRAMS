<div class="container py-5">
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
            Create User
        </button>
    </div>

    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-controller="UserManagement" asp-action="Register" method="post">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Create User</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label class="form-label">Username</label>
                            <input name="UserName" class="form-control" placeholder="Enter your username" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Email</label>
                            <input name="Email" type="email" class="form-control" placeholder="Enter your email" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Password</label>
                            <input name="Password" type="password" class="form-control" placeholder="Enter your password" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label"> Confirm Password</label>
                            <input name="ConfirmPassword" type="password" class="form-control" placeholder="Enter your password Again " required />
                        </div>
                        <input type="hidden" id="Role" name="Role" value="User" />

                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" id="adminSwitch" onchange="setRole(this)">
                            <label class="form-check-label" for="adminSwitch">Admin</label>
                        </div>

                        <script>
                            function setRole(checkbox) {
                                const roleInput = document.getElementById("Role");
                                roleInput.value = checkbox.checked ? "Admin" : "User";
                            }
                        </script>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Register</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var shouldOpenModal = '@ViewBag.ShowModal' === 'True';
            if (shouldOpenModal) {
                var myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
                myModal.show();
            }
        });
    </script>
}
